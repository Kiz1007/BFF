!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>For Shiya ♡</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Great+Vibes&family=Poppins:wght@300;400;500;600&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    font-family: 'Poppins', sans-serif;
    color: white;
    background: #080611;
    overflow-x: hidden;
}

/* ================= BACKGROUND ================= */

.background {
    position: fixed;
    inset: 0;
    z-index: -10;
    background:
        radial-gradient(circle at 20% 20%, #4d1d42 0%, transparent 30%),
        radial-gradient(circle at 80% 30%, #241a52 0%, transparent 30%),
        radial-gradient(circle at 50% 100%, #421d38 0%, transparent 35%),
        #080611;
}

.stars {
    position: fixed;
    inset: 0;
    z-index: -5;
    overflow: hidden;
}

.star {
    position: absolute;
    width: 3px;
    height: 3px;
    background: white;
    border-radius: 50%;
    animation: twinkle 3s infinite ease-in-out;
}

@keyframes twinkle {
    0%,100% {
        opacity: .2;
        transform: scale(.7);
    }
    50% {
        opacity: 1;
        transform: scale(1.4);
    }
}

/* ================= FLOATING HEARTS ================= */

.heart {
    position: fixed;
    bottom: -50px;
    color: #eaa5c0;
    font-size: 20px;
    pointer-events: none;
    animation: floatHeart linear forwards;
    z-index: 10;
}

@keyframes floatHeart {
    0% {
        transform: translateY(0) rotate(0);
        opacity: 0;
    }

    15% {
        opacity: .8;
    }

    100% {
        transform: translateY(-110vh) rotate(360deg);
        opacity: 0;
    }
}

/* ================= HERO ================= */

.hero {
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 30px;
}

.hero-content {
    max-width: 800px;
}

.small-title {
    font-size: 12px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: #d9a7bc;
    margin-bottom: 25px;
}

.hero h1 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(75px, 15vw, 150px);
    font-weight: 400;
    color: #fff;
    text-shadow:
        0 0 20px rgba(255,150,190,.4),
        0 0 50px rgba(255,100,170,.2);
}

.hero h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(28px, 5vw, 45px);
    font-weight: 400;
    margin-top: -10px;
    color: #e9c3d1;
}

.hero p {
    max-width: 550px;
    margin: 25px auto;
    color: #aaa1ad;
    line-height: 1.8;
    font-size: 14px;
}

.scroll {
    margin-top: 50px;
    color: #897d8b;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.scroll span {
    display: block;
    width: 1px;
    height: 55px;
    margin: 15px auto;
    background: linear-gradient(white, transparent);
}

/* ================= ENVELOPE ================= */

.envelope-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 20px;
}

.envelope-container {
    text-align: center;
}

.envelope-title {
    font-family: 'Great Vibes', cursive;
    font-size: 45px;
    color: #e4a9bd;
    margin-bottom: 35px;
}

.envelope {
    position: relative;
    width: 430px;
    height: 280px;
    max-width: 90vw;
    margin: auto;
    cursor: pointer;
    perspective: 1000px;
}

/* envelope body */

.envelope-body {
    position: absolute;
    inset: 0;
    background: linear-gradient(145deg, #a44c70, #632c50);
    border-radius: 8px;
    box-shadow:
        0 30px 70px rgba(0,0,0,.5),
        0 0 40px rgba(185,80,130,.15);
    overflow: hidden;
}

.envelope-body::before {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    border-style: solid;
    border-width: 0 0 220px 215px;
    border-color: transparent transparent #833b5c transparent;
}

.envelope-body::after {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    border-style: solid;
    border-width: 220px 0 0 215px;
    border-color: transparent transparent transparent #913f62;
}

/* paper */

.letter-preview {
    position: absolute;
    width: 88%;
    height: 82%;
    left: 6%;
    bottom: 3%;
    background: #fff9f3;
    color: #533a45;
    z-index: 2;
    padding: 25px;
    text-align: left;
    transition: 1s ease;
    border-radius: 3px;
    box-shadow: 0 10px 30px rgba(0,0,0,.25);
}

.letter-preview h3 {
    font-family: 'Great Vibes', cursive;
    color: #914c68;
    font-size: 30px;
}

.letter-preview p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 17px;
    margin-top: 8px;
}

/* flap */

.flap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 60%;
    background: linear-gradient(145deg, #c16b89, #8c3e5e);
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    transform-origin: top;
    transition: 1s cubic-bezier(.2,.8,.2,1);
    z-index: 5;
}

/* seal */

.seal {
    position: absolute;
    width: 65px;
    height: 65px;
    background: #702442;
    border: 2px solid #e7a9bc;
    border-radius: 50%;
    left: 50%;
    top: 54%;
    transform: translate(-50%, -50%);
    z-index: 7;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 27px;
    box-shadow: 0 5px 20px rgba(0,0,0,.4);
    transition: .5s;
}

.envelope.open .flap {
    transform: rotateX(180deg);
}

.envelope.open .letter-preview {
    transform: translateY(-145px);
}

.envelope.open .seal {
    opacity: 0;
}

.click-text {
    margin-top: 35px;
    font-size: 11px;
    letter-spacing: 3px;
    color: #968895;
}

/* ================= LETTER ================= */

.letter-section {
    padding: 100px 20px 150px;
}

.paper {
    max-width: 850px;
    margin: auto;
    background: #fff9f2;
    color: #493840;
    padding: 70px clamp(30px,8vw,80px);
    position: relative;
    box-shadow: 0 40px 100px rgba(0,0,0,.5);
}

.paper::before {
    content: "";
    position: absolute;
    inset: 15px;
    border: 1px solid #dfcbd0;
    pointer-events: none;
}

.paper-top {
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 4px;
    font-size: 10px;
    color: #a17786;
}

.paper h2 {
    text-align: center;
    font-family: 'Great Vibes', cursive;
    font-size: 65px;
    font-weight: 400;
    color: #914c68;
    margin: 10px 0 30px;
}

.divider {
    display: flex;
    align-items: center;
    gap: 15px;
    margin: 30px 0 45px;
    color: #a95e78;
}

.divider::before,
.divider::after {
    content: "";
    height: 1px;
    background: #dfc9cf;
    flex: 1;
}

.paper p {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    line-height: 1.85;
    margin-bottom: 25px;
}

.paper p:first-of-type::first-letter {
    font-size: 70px;
    float: left;
    line-height: .7;
    padding: 8px 8px 0 0;
    color: #a25570;
}

.quote {
    margin: 45px 0;
    padding: 30px;
    border-left: 3px solid #a85c77;
    background: #f5e7e7;
    font-family: 'Cormorant Garamond', serif;
    font-size: 25px;
    font-style: italic;
    color: #714355;
}

.signature {
    text-align: right;
    margin-top: 55px;
}

.signature span {
    font-family: 'Great Vibes', cursive;
    font-size: 45px;
    color: #914c68;
}

.signature small {
    display: block;
    font-size: 9px;
    letter-spacing: 3px;
    color: #9a858d;
    margin-top: 5px;
}

/* ================= MEMORIES ================= */

.memories {
    padding: 80px 20px 150px;
    text-align: center;
}

.memories h2 {
    font-family: 'Great Vibes', cursive;
    font-size: 65px;
    font-weight: 400;
    color: #e5adbf;
}

.memories > p {
    color: #968b98;
    font-size: 13px;
    margin: 10px 0 50px;
}

.memory-grid {
    max-width: 950px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 18px;
}

.memory {
    min-height: 230px;
    padding: 25px;
    text-align: left;
    border: 1px solid rgba(255,255,255,.08);
    background: linear-gradient(145deg,rgba(193,95,132,.16),rgba(255,255,255,.025));
    border-radius: 10px;
    transition: .4s;
}

.memory:hover {
    transform: translateY(-10px);
    border-color: rgba(225,150,180,.3);
    box-shadow: 0 20px 50px rgba(0,0,0,.25);
}

.memory .icon {
    font-size: 35px;
}

.memory h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    margin-top: 50px;
    color: #ead1da;
}

.memory p {
    font-size: 12px;
    color: #968b98;
    line-height: 1.6;
    margin-top: 5px;
}

/* ================= END ================= */

.end {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 50px 20px;
}

.end-content {
    max-width: 650px;
}

.big-heart {
    font-size: 65px;
    color: #df8fab;
    animation: heartbeat 2s infinite;
}

@keyframes heartbeat {
    0%,100% { transform: scale(1); }
    50% { transform: scale(1.15); }
}

.end h2 {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(55px,10vw,100px);
    font-weight: 400;
    color: #f0d4dd;
}

.end p {
    color: #9d919c;
    line-height: 1.9;
    font-size: 14px;
}

.end .shiya {
    font-family: 'Great Vibes', cursive;
    color: #df9db4;
    font-size: 45px;
    margin-top: 30px;
}

footer {
    text-align: center;
    padding: 30px;
    color: #554c58;
    font-size: 9px;
    letter-spacing: 3px;
}

/* ================= MOBILE ================= */

@media(max-width:700px) {

    .envelope {
        height: 230px;
    }

    .envelope.open .letter-preview {
        transform: translateY(-110px);
    }

    .letter-preview p {
        font-size: 14px;
    }

    .memory-grid {
        grid-template-columns: 1fr;
    }

    .memory {
        min-height: 180px;
    }

    .memory h3 {
        margin-top: 25px;
    }

    .paper {
        padding: 55px 28px;
    }

    .paper p {
        font-size: 19px;
    }

    .quote {
        font-size: 21px;
    }
}
</style>
</head>

<body>

<div class="background"></div>
<div class="stars" id="stars"></div>

<!-- ================= HERO ================= -->

<section class="hero">

<div class="hero-content">

<div class="small-title">
A little something for my best friend
</div>

<h1>Shiya</h1>

<h2>Five years. Countless memories. One friendship.</h2>

<p>
Some people come into your life for a short time.
Some stay long enough to become family.
You are one of those people.
</p>

<div class="scroll">
SCROLL DOWN
<span></span>
</div>

</div>

</section>


<!-- ================= ENVELOPE ================= -->

<section class="envelope-section">

<div class="envelope-container">

<div class="envelope-title">
I wrote something for you...
</div>

<div class="envelope" id="envelope" onclick="openEnvelope()">

<div class="envelope-body"></div>

<div class="letter-preview">

<h3>Dear Shiya,</h3>

<p>
There are five years worth of things
I could say to you...
</p>

</div>

<div class="flap"></div>

<div class="seal">
♥
</div>

</div>

<div class="click-text" id="clickText">
CLICK THE ENVELOPE
</div>

</div>

</section>


<!-- ================= LETTER ================= -->

<section class="letter-section">

<div class="paper">

<div class="paper-top">
A letter from the heart
</div>

<h2>For You</h2>

<div class="divider">
♥
</div>


<p>
I feel so truly blessed to have a best friend like you. Thank you for everything you’ve done for me—especially during all my ups and downs. You’ve never left my side, and whenever I needed someone, you were always right there.
</p>

<p>
Thank you for five amazing years of friendship, and here’s to many more. I also want to thank you for how understanding you are about my feelings for you. We both liked each other back then, and even though those feelings returned for me, you still accepted me completely. Knowing you accept me as I am means the world to me.
</p>

<p>
You’ve been my go-to person ever since 9th grade. Even if we don’t always get to hang out in person and most of our bonding happens over chat or playing CODM—my favorite duo—it’s always so much fun and full of genuine laughter.
</p>


<div class="quote">
"Five years of friendship, countless conversations,
and somehow you still remain one of the most
important people in my life."
</div>


<p>
I am so grateful to have met you and to call you my best friend. Even back when I had a girlfriend, you were the person I turned to with my problems, just as you came to me with yours. It meant so much to me that you trusted me enough to vent and open up.
</p>

<p>
A part of me thinks it would have been wonderful if we had ever gotten the chance to be together, but at the end of the day, I am just so thankful to have you as part of my family. I honestly don't know where I'd be without you. You are everything I could have ever wanted in a person, and you are so special to me.
</p>

<p>
Now that you're leaving, it's tough. You know me so well—you even know how easily I get teary-eyed when it comes to things like this—and I’m so grateful for that closeness.
</p>

<p>
Thank you for being the most important girl in my life. You may not be my girlfriend, but you are the girl who stays by my side through everything and remains my safe haven.
</p>

<p>
Please never forget that I am always here for you. I will never leave your side, Shiya, and you know that. You can reach out to me with your problems anytime, anywhere. I am so lucky to have a friend like you, and I would never trade you for anyone in the world.
</p>

<p>
Wishing you all the best on your next journey.
</p>


<div class="signature">

<span>Always here for you ♡</span>

<small>
YOUR FAVORITE CODM DUO
</small>

</div>

</div>

</section>


<!-- ================= MEMORIES ================= -->

<section class="memories">

<h2>Our Little Things</h2>

<p>
The things that made five years feel like home.
</p>

<div class="memory-grid">

<div class="memory">

<div class="icon">🎮</div>

<h3>Our Duo</h3>

<p>
From random matches to laughing over the most ridiculous moments.
My favorite CODM teammate.
</p>

</div>


<div class="memory">

<div class="icon">💬</div>

<h3>Our Chats</h3>

<p>
The conversations, the rants, the random messages,
and being the person we could always talk to.
</p>

</div>


<div class="memory">

<div class="icon">♡</div>

<h3>Five Years</h3>

<p>
From 9th grade until now.
Five years of friendship that became something more like family.
</p>

</div>

</div>

</section>


<!-- ================= END ================= -->

<section class="end">

<div class="end-content">

<div class="big-heart">
♡
</div>

<h2>Until our next chapter...</h2>

<p>
No matter where life takes us, I hope you always remember
that there will always be someone here cheering for you,
listening to you, and ready to play one more game with you.
</p>

<div class="shiya">
Good luck, Shiya.
</div>

</div>

</section>


<footer>
MADE WITH LOVE • FOR FIVE YEARS OF FRIENDSHIP ♡
</footer>


<script>

/* ================= STARS ================= */

const stars = document.getElementById("stars");

for(let i = 0; i < 120; i++){

    const star = document.createElement("div");

    star.classList.add("star");

    star.style.left = Math.random() * 100 + "%";
    star.style.top = Math.random() * 100 + "%";

    const size = Math.random() * 3 + 1;

    star.style.width = size + "px";
    star.style.height = size + "px";

    star.style.animationDelay = Math.random() * 4 + "s";

    stars.appendChild(star);
}


/* ================= ENVELOPE ================= */

function openEnvelope(){

    const envelope = document.getElementById("envelope");
    const text = document.getElementById("clickText");

    envelope.classList.toggle("open");

    if(envelope.classList.contains("open")){

        text.innerHTML = "THE LETTER IS OPEN ♡";

        setTimeout(() => {

            document.querySelector(".letter-section")
            .scrollIntoView({behavior:"smooth"});

        }, 900);

    }else{

        text.innerHTML = "CLICK THE ENVELOPE";

    }

}


/* ================= FLOATING HEARTS ================= */

function createHeart(){

    const heart = document.createElement("div");

    heart.className = "heart";

    const hearts = ["♡","♥","✦","·"];

    heart.innerHTML =
        hearts[Math.floor(Math.random() * hearts.length)];

    heart.style.left = Math.random() * 100 + "vw";

    heart.style.fontSize =
        (Math.random() * 18 + 10) + "px";

    heart.style.animationDuration =
        (Math.random() * 5 + 6) + "s";

    document.body.appendChild(heart);

    setTimeout(() => {

        heart.remove();

    }, 11000);
}

setInterval(createHeart, 700);


/* ================= CLICK ANYWHERE = HEART ================= */

document.addEventListener("click", function(e){

    if(e.target.closest(".envelope")) return;

    for(let i = 0; i < 3; i++){

        const heart = document.createElement("div");

        heart.className = "heart";

        heart.innerHTML = "♡";

        heart.style.position = "absolute";

        heart.style.left = e.pageX + (Math.random()*30-15) + "px";

        heart.style.top = e.pageY + (Math.random()*30-15) + "px";

        heart.style.animationDuration = "3s";

        document.body.appendChild(heart);

        setTimeout(() => heart.remove(), 3000);

    }

});

</script>

</body>
</html>
